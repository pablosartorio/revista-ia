  :root {
    --bg: #0a0f1e; --panel: #111829; --texto: #dbe2f0; --tenue: #8a97b1;
    --borde: #1e2942; --acento: #6366f1; --ok: #34d399; --warn: #fbbf24; --mal: #f87171;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--texto);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 16.5px; line-height: 1.65; -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 900px; margin: 0 auto; padding: 0 20px 72px; }
  .mono { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
  a { color: var(--acento); text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.16); }
  a:hover { border-bottom-color: currentColor; }
  h1 { font-size: clamp(28px, 5vw, 42px); line-height: 1.12; margin: 14px 0 12px; letter-spacing: -.022em; font-weight: 660; }
  h3 { font-size: 20.5px; line-height: 1.32; margin: 0 0 11px; letter-spacing: -.011em; font-weight: 640; color: #f0f4fc; }
  p { margin: 0 0 13px; }
  .badge {
    display: inline-block; font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #0a0f1e;
    background: linear-gradient(135deg, #8b5cf6, #0ea5e9); padding: 4px 11px; border-radius: 3px; font-weight: 700;
  }
  .meta { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12.5px; color: var(--tenue); display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .meta b { color: #b9c4da; font-weight: 600; }
  section { padding-top: 30px; margin-top: 30px; border-top: 1px solid var(--borde); }
  h2.seccion { font-size: 13px; letter-spacing: .13em; text-transform: uppercase; color: var(--acento); margin: 0 0 20px; font-weight: 700; display: flex; align-items: center; gap: 11px; }
  .sigla { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 10px; letter-spacing: .06em; color: var(--acento); border: 1px solid var(--acento); border-radius: 3px; padding: 2px 6px; opacity: .8; }
  .fuente { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12.5px; color: var(--tenue); margin-top: 12px; padding-left: 13px; border-left: 2px solid var(--acento); overflow-wrap: anywhere; }
  .panel { background: var(--panel); border: 1px solid var(--borde); border-radius: 8px; padding: 20px 22px; }
  .tabla-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th, td { text-align: left; vertical-align: top; padding: 7px 8px; border-bottom: 1px solid var(--borde); }
  th { color: var(--tenue); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  .est { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px; white-space: nowrap; }
  .est.confirmado { color: var(--ok); } .est.corregido, .est.matizado { color: #60a5fa; }
  .est.retirado { color: var(--tenue); text-decoration: line-through; }
  .est.no_verificable, .est.sin_consenso { color: var(--warn); } .est.contradicho, .est.no_aplicado { color: var(--mal); }
  del { background: rgba(248,113,113,.18); color: #fecaca; text-decoration: line-through; }
  ins { background: rgba(52,211,153,.16); color: #bbf7d0; text-decoration: none; }
  img { max-width: 100%; height: auto; }
  @media print {
    :root { --bg: #fff; --panel: #fff; --texto: #14181f; --tenue: #55606f; --borde: #d6dbe4; }
    body { font-size: 11pt; } .wrap { max-width: none; padding: 0; }
    h1, h3 { color: #0b0f16; } a { color: #1f2937; border: 0; }
    section, article { break-inside: avoid; }
  }
